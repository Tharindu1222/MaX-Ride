{
  "name": "max-ride",
  "version": "1.0.0",
  "private": true,
  "description": "MaX Ride — Sri Lanka ride-hailing platform (LKR)",
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
